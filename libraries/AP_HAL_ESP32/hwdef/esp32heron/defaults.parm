# Baked into firmware ROMFS (boards.py). Board-level defaults only; airframe/link params live in uav/params/heron.param.
# v3: SERIAL1 is an Empty driver (WiFi off); SERIAL2 = ELRS MAVLink at 460800; battery on GPIO36.
SERIAL1_PROTOCOL -1
SERIAL2_PROTOCOL 2
SERIAL2_BAUD 460
SERIAL3_PROTOCOL 5
BATT_MONITOR 3
BATT_VOLT_PIN 36
BATT_VOLT_MULT 11.0
LOG_BACKEND_TYPE 1
COMPASS_ENABLE 1
