# HERON flight controller v3: ESP32-DevKit 30-pin, ESP32-D0WD-V3 (WROOM-32), 4 MB flash, no PSRAM.
# Copy this folder to <ardupilot>/libraries/AP_HAL_ESP32/hwdef/esp32heron/ . Name MUST start with "esp32"
# and MUST NOT end with "empty" (that builds SIM-on-HW with no servo output, Tools/ardupilotwaf/boards.py).
# v3 (2026-11-05): ELRS receiver in MAVLink mode on UART2 (RX34/TX33), WiFi OFF, no PPM input,
# battery sense moved 34 -> 36, RCOUT ch4 (GPIO33) removed. Every pin is justified in uav/fc/FC_SPEC.md section 3.

define HAL_ESP32_BOARD_NAME "esp32-heron"

# ---------- SPI: GY-91 (MPU9250/MPU6500 + BMP280) on VSPI (SPI3) ----------
# DMA channel 2, NOT 1: SdCard.cpp always uses SPI2_HOST with DMA channel 1. Two buses on DMA 1 = SD mount fails.
#            Host      DMA  MOSI        MISO        SCLK
ESP32_SPIBUS VSPI_HOST 2    GPIO_NUM_23 GPIO_NUM_19 GPIO_NUM_18

#            Name     Bus Dev ChipSel     Mode LoSpeed HiSpeed
ESP32_SPIDEV bmp280   0   0   GPIO_NUM_26 3    1*MHZ   1*MHZ
ESP32_SPIDEV mpu9250  0   1   GPIO_NUM_5  0    1*MHZ   8*MHZ

# Invensense driver accepts WHOAMI 0x68/0x70/0x71/0x73. The GY-91 we own is an MPU6500 (0x70): fine.
IMU Invensense SPI:mpu9250 ROTATION_NONE
define HAL_INS_DEFAULT HAL_INS_MPU9250_SPI
define HAL_INS_MPU9250_NAME "mpu9250"

BARO BMP280 SPI:bmp280
define HAL_BARO_ALLOW_INIT_NO_BARO 1

# ---------- I2C: external bus for GY-271 compass ----------
# INTERNAL must be false: AP_Compass.cpp probes QMC5883L/QMC5883P only on EXTERNAL buses.
#             Port       SDA         SCL          SPEED    INTERNAL SOFT
ESP32_I2CBUS  I2C_NUM_0  GPIO_NUM_21 GPIO_NUM_22  100*KHZ  false    false
define AP_COMPASS_PROBING_ENABLED 1

# ---------- UARTs ----------
# Table index -> SERIALn (HAL_ESP32_Class.cpp): index 0 = SERIAL0 (USB), index 1 = SERIAL3 (GPS), index 2 = SERIAL2 (ELRS).
# GPIO34 is input-only (fine for RX); it has no internal pull-up, so the board fits a 10k pull-up to 3V3.
#             PORT        RX           TX
ESP32_SERIAL  UART_NUM_0  GPIO_NUM_3   GPIO_NUM_1
ESP32_SERIAL  UART_NUM_1  GPIO_NUM_16  GPIO_NUM_17
ESP32_SERIAL  UART_NUM_2  GPIO_NUM_34  GPIO_NUM_33
define DEFAULT_SERIAL2_PROTOCOL SerialProtocol_MAVLink2
define DEFAULT_SERIAL3_PROTOCOL SerialProtocol_GPS

# ---------- WiFi: OFF. HAL_ESP32_WIFI undefined -> SERIAL1 = Empty driver (HAL_ESP32_Class.cpp). No password exists. ----------

# ---------- RC input: none on a pin. RC arrives as MAVLink RADIO_RC_CHANNELS from ELRS on SERIAL2. ----------
# HAL_ESP32_RCIN undefined -> RMT reader not started (RCInput.cpp #ifdef); AP::RC() still decodes MAVLink radio.
# BUT SoftSigReaderRMT.cpp is compiled for every ESP32 board and #errors without the next define (CI failure 2026-11-05).
# Compile-only placeholder: init() runs only if HAL_ESP32_RCIN is defined, so GPIO4 (unused, never connect) is never configured.
define HAL_ESP32_RMT_RX_PIN_NUMBER 4

# ---------- RC outputs (MCPWM; consecutive pairs share one timer/frequency) ----------
# ch1 ESC, ch2 elevator, ch3 rudder, ch4 spare (GPIO2 = strapping pin + onboard LED: leave empty unless needed)
ESP32_RCOUT GPIO_NUM_25
ESP32_RCOUT GPIO_NUM_27
ESP32_RCOUT GPIO_NUM_32
ESP32_RCOUT GPIO_NUM_2

# ---------- ADC1 only. Gain 1 = volts at the pin. GPIO34 is NOT here: it is UART2 RX now. ----------
#             Channel             Gain ArduPin
ESP32_ADC_PIN ADC1_GPIO36_CHANNEL 1    36
ESP32_ADC_PIN ADC1_GPIO39_CHANNEL 1    39
# 10k / 1k divider = x11; calibrate BATT_VOLT_MULT with a multimeter (gate B8)
define HAL_BATT_VOLT_PIN 36
define HAL_BATT_VOLT_SCALE 11.0

# ---------- SD card on SPI2 (HSPI) for logs ----------
#           Host      DMA MOSI        MISO        SCLK        CS
ESP32_SDSPI HSPI_HOST 1   GPIO_NUM_13 GPIO_NUM_35 GPIO_NUM_14 GPIO_NUM_15
define HAL_ESP32_SDCARD 1
define AP_FILESYSTEM_ESP32_ENABLED 1
define HAL_LOGGING_FILESYSTEM_ENABLED 1
define HAL_LOGGING_DATAFLASH_ENABLED 0
define HAL_LOGGING_MAVLINK_ENABLED 0
define HAL_LOGGING_BACKENDS_DEFAULT 1

# ---------- misc ----------
define AP_AIRSPEED_ENABLED 0
define DEFAULT_NTF_LED_TYPES Notify_LED_None
